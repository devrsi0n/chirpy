{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@chirpy-dev/tsconfigs/base.json",
  "compilerOptions": {
    "types": ["jest", "node", "@testing-library/jest-dom"]
  },
  "exclude": ["node_modules"],
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "./typings/*.d.ts",
