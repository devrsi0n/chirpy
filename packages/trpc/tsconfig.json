{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@chirpy-dev/tsconfigs/base.json",
  "compilerOptions": {
    "types": ["jest", "node"]
  },
  "exclude": ["node_modules"],
  "include": [
    "typings/**/*.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "../tsconfigs/typings/*.d.ts"
  ]
}
