{
  "$schema": "https://turborepo.dev/schema.json",
  "globalDependencies": ["tsconfig.json", ".env.*"],
  "globalEnv": ["GITHUB_TOKEN"],
  "tasks": {
    "build": {
      "dependsOn": ["^build", "^generate"],
      "outputs": ["dist/**", "lib/**"]
    },
    "test": {
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "dev": {
      "dependsOn": ["^generate"],
      "cache": false
    },
    "@chirpy-dev/main-app#build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"],
      "env": [
        "NEXT_PUBLIC_APP_URL",
        "SUPABASE_URL",
        "NEXTAUTH_SECRET",
        "EMAIL_API_KEY",
        "NEXT_PUBLIC_VAPID"
      ]
    },
    "@chirpy-dev/service-worker#build": {
      "cache": false
    },
    "@chirpy-dev/bootstrapper#build": {
      "cache": false
    },
    "build:local": {
      "cache": false
    },
    "generate": {
      "cache": false
    },
    "db": {
      "cache": false
    },
    "@chirpy-dev/analytics#build": {
      "cache": false,
      "outputs": []
    }
  },
  "globalPassThroughEnv": [
    "SKIP_ENV_VALIDATION",
    "SUPABASE_URL",
    "NEXTAUTH_*",
    "NEXT_PUBLIC_*",
    "PRIVATE_VAPID",
    "EMAIL_API_KEY",
    "STRIPE_*",
    "SW_CACHE_ID",
    "QSTASH_*",
    "TINYBIRD_ADMIN_TOKEN",
    "CRON_SECRET",
    "ANALYZE",
    "RELATIVE_CI_KEY"
  ]
}
